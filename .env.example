# Nuki Smart Lock Notification System — environment template
# Copy this file to .env, fill in your values, then: docker compose up -d
# NOTE: .env is git-ignored. Never commit real values.

# --- Required ---
# Secret key for Flask web sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, the container generates an ephemeral key at startup
# (web sessions will not survive restarts).
SECRET_KEY=

# --- General Settings ---
# NUKI_NOTIFICATION_TYPE: both, telegram, email, or none
NUKI_NOTIFICATION_TYPE=both
NUKI_POLLING_INTERVAL=60

# --- Web UI ---
# Host port for the dashboard (container always listens on 5000)
NUKI_WEB_PORT=5000

# --- API Settings ---
# NUKI_API_TOKEN can be set here, or in config/credentials.ini (file wins if env empty)
# NUKI_API_TOKEN=your_nuki_api_token_here
# NUKI_SMARTLOCK_ID=your_explicit_lock_id_here
# NUKI_USE_EXPLICIT_ID=false

# --- Telegram Settings ---
# NUKI_TELEGRAM_BOT_TOKEN=your_bot_token_here
# NUKI_TELEGRAM_CHAT_ID=your_chat_id_here
NUKI_TELEGRAM_USE_EMOJI=true
NUKI_TELEGRAM_FORMAT=detailed

# --- Email Settings ---
NUKI_SMTP_SERVER=smtp.gmail.com
NUKI_SMTP_PORT=587
# NUKI_EMAIL_USERNAME=your_email@gmail.com
# NUKI_EMAIL_PASSWORD=your_app_password_here
# NUKI_EMAIL_SENDER=your_email@gmail.com
# NUKI_EMAIL_RECIPIENT=recipient_email@example.com
NUKI_EMAIL_USE_HTML=true
NUKI_EMAIL_SUBJECT_PREFIX=Nuki Alert

# --- Notification Filters ---
# Comma-separated lists
NUKI_EXCLUDED_USERS=
NUKI_EXCLUDED_ACTIONS=
NUKI_EXCLUDED_TRIGGERS=

# --- Quiet Hours ---
# During the quiet window events are queued and delivered as one digest when
# the window ends. Times are 24h HH:MM in the container's TZ; may span midnight.
NUKI_QUIET_HOURS_ENABLED=false
NUKI_QUIET_START=22:00
NUKI_QUIET_END=07:00
# Alert when the door sensor reports the door opened
NUKI_NOTIFY_DOOR_OPEN=false

# --- Instant Push (Webhook) ---
# Public HTTPS base URL of this dashboard (e.g. a Pangolin tunnel hostname).
# The webhook secret is generated in the UI (Notifications > Instant Push) and
# stored in config/credentials.ini — never commit it.
NUKI_WEBHOOK_ENABLED=false
NUKI_WEBHOOK_PUBLIC_URL=

# --- Self-Monitoring ---
# Consecutive failed activity checks before a system alert is sent
NUKI_ALERT_FAILURE_THRESHOLD=3

# --- Reverse Proxy (Pangolin / nginx / Caddy) ---
# Trust X-Forwarded-* headers (client IPs in the audit log, correct scheme)
PROXY_FIX=false
# Set true when the proxy terminates HTTPS (secure cookies, passkey support)
WEB_HTTPS=false

# --- Advanced Settings ---
NUKI_DEBUG_MODE=false
NUKI_MAX_EVENTS_PER_CHECK=5
NUKI_MAX_HISTORICAL_EVENTS=20
NUKI_USER_CACHE_TIMEOUT=3600
NUKI_RETRY_ON_FAILURE=true
NUKI_MAX_RETRIES=3
NUKI_RETRY_DELAY=5

# --- Container Settings ---
CONFIG_DIR=/app/config
LOGS_DIR=/app/logs
TZ=Europe/London
DEFAULT_THEME=dark
GUNICORN_WORKERS=2
